# Codex bridge
CODEX_BIN=codex
CODEX_CWD=/workspace
CODEX_MODEL=gpt-5.3-codex
CODEX_MAIN_MODEL=gpt-5.3-codex
CODEX_FAST_MODEL=gpt-5.3-codex-spark
ENABLE_DEFAULT_THREAD_RESUME=1
ENABLE_PERSIST_THREAD_STATE=1
THREAD_STATE_FILE=.runtime/thread-state.json

# Bridge server
PORT=8788
CLIENT_SHARED_TOKEN=replace_with_long_random_token
ALLOWED_ORIGINS=https://codex-even-app.example.com,http://localhost:5173,http://127.0.0.1:5173

# STT layer
# Use `none` for text-only/manual mode, `elevenlabs` for streaming STT.
STT_PROVIDER=elevenlabs
STT_API_KEY=
STT_LANGUAGE=en
STT_MODEL_ID=scribe_v2_realtime
STT_COMMIT_STRATEGY=vad
# Optional ElevenLabs VAD tuning (helps reduce quiet/noise false positives).
STT_VAD_THRESHOLD=0.65
STT_MIN_SPEECH_DURATION_MS=400
STT_MIN_SILENCE_DURATION_MS=250
STT_VAD_SILENCE_THRESHOLD_SECS=2.0

# Even frontend endpoint
VITE_WS_BASE_URL=wss://codex-even-api.example.com/ws
VITE_CLIENT_SHARED_TOKEN=replace_with_long_random_token
VITE_TEXT_UPDATE_THROTTLE_MS=120
