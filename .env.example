# Codex bridge
CODEX_BIN=codex
CODEX_CWD=/workspace
CODEX_MODEL=gpt-5-codex

# Bridge server
PORT=8788
CLIENT_SHARED_TOKEN=replace_with_long_random_token
ALLOWED_ORIGINS=https://codex-even-app.example.com,http://localhost:5173,http://127.0.0.1:5173

# STT layer
# Use `none` for text-only/manual mode, `elevenlabs` for streaming STT.
STT_PROVIDER=elevenlabs
STT_API_KEY=
STT_LANGUAGE=en
STT_MODEL_ID=scribe_v2_realtime
STT_COMMIT_STRATEGY=vad

# Even frontend endpoint
VITE_WS_BASE_URL=wss://codex-even-api.example.com/ws
VITE_CLIENT_SHARED_TOKEN=replace_with_long_random_token
VITE_TEXT_UPDATE_THROTTLE_MS=120
