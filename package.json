{
  "name": "even-codex-bridge",
  "version": "0.1.0",
  "description": "Text-first Codex bridge for Even G2 glasses",
  "main": "server/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev:server": "./scripts/local/run-codex-even-server.sh",
    "dev:server:raw": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev": "concurrently -k -n SERVER,CLIENT -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "tunnel": "./scripts/local/run-codex-even-tunnel.sh",
    "tunnel:quick": "./scripts/local/run-codex-even-tunnel.sh --quick",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173"
  },
  "keywords": [
    "even",
    "codex",
    "bridge"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.3.1"
  }
}
